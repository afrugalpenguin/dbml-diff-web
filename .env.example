# Upstash Redis REST credentials. Required in every environment:
# the rate limiter on /api/diff and /api/share uses Redis.
# Use a separate database for Production, Preview and Development.
KV_REST_API_URL=https://your-database.upstash.io
KV_REST_API_TOKEN=your-read-write-token

# Optional. Used by /c/[id] to read shared comparisons.
# Falls back to KV_REST_API_TOKEN when unset.
KV_REST_API_READ_ONLY_TOKEN=your-read-only-token
